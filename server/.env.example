# Edara backend configuration.
# Copy this file to `server/.env` and adjust as needed. Every value is optional; the
# server falls back to the defaults shown below when a variable is unset.
#
#   Windows (PowerShell):  Copy-Item server\.env.example server\.env
#   Windows (cmd):         copy server\.env.example server\.env

# Interface the API/WebSocket server binds to.
#   0.0.0.0   -> reachable from other machines on the LAN (default)
#   127.0.0.1 -> local-only (this machine can connect, the network cannot)
HOST=0.0.0.0

# Port the API/WebSocket server listens on.
# Keep this at 3000 unless you also update the proxy target in client/vite.config.ts.
PORT=3000

# Secret used to sign JWT auth tokens. CHANGE THIS to a long, random string in real use.
JWT_SECRET=edara-secret-key-change-in-production
